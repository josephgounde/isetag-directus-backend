# Copier vers .env.prod sur le VPS (jamais commité). Utilisé avec :
#   docker compose -f docker/prod/docker-compose.yml --env-file .env.prod up -d

# --- PostgreSQL ---
DB_DATABASE=isetag
DB_USER=isetag
DB_PASSWORD=                 # généré, distinct du mot de passe dev

# --- Directus ---
DIRECTUS_KEY=                 # openssl rand -hex 32 (distinct de dev/staging)
DIRECTUS_SECRET=              # openssl rand -hex 32 (distinct de dev/staging)
DIRECTUS_ADMIN_EMAIL=admin@isetag-univ.net
DIRECTUS_ADMIN_PASSWORD=      # mot de passe fort, distinct de dev/staging
DIRECTUS_PUBLIC_URL=https://cms.isetag-univ.net

# --- Frontend (image construite par la CI et poussée sur ghcr.io) ---
FRONTEND_IMAGE=ghcr.io/<owner>/<repo>-frontend:latest

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ISETAG <noreply@isetag-univ.net>"

# Adresse qui reçoit les notifications de pré-inscription (formulaire public -> Flow Directus -> email)
ADMISSIONS_EMAIL=admissions@isetag-univ.net
CONTACT_EMAIL=contact@isetag-univ.net
