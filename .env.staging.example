# Copier vers .env.staging sur le VPS (jamais commité). Utilisé avec :
#   docker compose -f docker/staging/docker-compose.yml --env-file .env.staging up -d

# --- PostgreSQL ---
DB_DATABASE=isetag_staging
DB_USER=isetag_staging
DB_PASSWORD=                 # généré, distinct du mot de passe prod

# --- Directus ---
DIRECTUS_KEY=                 # openssl rand -hex 32 (distinct de dev/prod)
DIRECTUS_SECRET=              # openssl rand -hex 32 (distinct de dev/prod)
DIRECTUS_ADMIN_EMAIL=admin@isetag-univ.net
DIRECTUS_ADMIN_PASSWORD=      # mot de passe fort, distinct de dev/prod
DIRECTUS_PUBLIC_URL=https://cms-staging.isetag-univ.net

# --- Frontend (image construite par la CI et poussée sur ghcr.io) ---
FRONTEND_IMAGE=ghcr.io/<owner>/<repo>-frontend:staging

# --- SMTP (peut pointer vers un compte de test) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ISETAG Staging <noreply@isetag-univ.net>"

# Adresse qui reçoit les notifications de pré-inscription (formulaire public -> Flow Directus -> email)
ADMISSIONS_EMAIL=admissions@isetag-univ.net
CONTACT_EMAIL=contact@isetag-univ.net
