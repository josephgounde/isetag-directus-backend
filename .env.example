# Copier ce fichier vers .env et renseigner les valeurs réelles.
# .env ne doit jamais être commité (voir .gitignore).

# --- PostgreSQL ---
DB_DATABASE=isetag
DB_USER=isetag
DB_PASSWORD=

# --- Directus ---
DIRECTUS_KEY=                # généré avec: openssl rand -hex 32 (identifiant unique du projet, requis par Directus)
DIRECTUS_SECRET=            # généré avec: openssl rand -hex 32
DIRECTUS_ADMIN_EMAIL=admin@isetag-univ.net
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_PUBLIC_URL=http://localhost:8055

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ISETAG <noreply@isetag-univ.net>"

# Adresse qui reçoit les notifications de pré-inscription (formulaire public -> Flow Directus -> email)
ADMISSIONS_EMAIL=admissions@isetag-univ.net
CONTACT_EMAIL=contact@isetag-univ.net
